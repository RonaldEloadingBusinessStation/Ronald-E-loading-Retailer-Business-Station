# Required for persistent retailer accounts, wallets, top-ups and orders
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Required for admin actions and Telegram alerts. Use a long random key.
ADMIN_KEY=replace-with-a-long-random-secret
# Optional: URL opened by the Telegram ADMIN PANEL button (defaults to the Render service URL)
ADMIN_PANEL_BASE_URL=https://ronald-e-loading-retailer-business.onrender.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Web Push notifications for the original public order website
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
NODE_ENV=production

# Numeric Telegram user ID allowed to use private admin commands/actions. Set your own numeric ID.
TELEGRAM_ADMIN_USER_ID=

# Separate Telegram bot for private admin management (created via @BotFather)
TELEGRAM_ADMIN_BOT_TOKEN=
